:: CE_moneyCheat [widget]

<<widget "CE_moneyCheat">>
<div class="dol-settings dol-shadow">

    <div class="dol-header">
        <span class="dol-title">收支倍率調整</span>
    </div>
    <div class="dol-body">

        <div class="dol-desc">
            調整正常收支的倍率，跳舞賺更多錢，給貝利交更少的錢。僅記帳操作保留原始金額。
        </div>
        <br>

        <<if $CE_moneyCheat is undefined>>
            <<set $CE_moneyCheat to false>>
            <<set $CE_moneyInMultiplier to 2>>
            <<set $CE_moneyOutMultiplier to 0.5>>
        <</if>>

        <div class="dol-btn">
        <<button "收支倍率調整">>
            <<set $CE_moneyCheat = $CE_moneyCheat == false? true : false>>        
            <<replace #CE_settingsDiv>><<CE_moneyCheat>><br><br><</replace>>
        <</button>></div>
        <br>

        <div class="dol-desc">
            收支倍率調整：
            <<if $CE_moneyCheat is false>>
                <span class="dol-red">關</span>
            <<else>>
                <span class="dol-green">開</span>
            <</if>>
        </div>
        <br>
        <div class ="dol-section">
            <div class="dol-desc">收入倍率（範圍:1-100）：</div>
            <<numberslider "$CE_moneyInMultiplier" $CE_moneyInMultiplier 1 100 0.5>><br>
            <div class="dol-desc">支出倍率（範圍0.1-1）：</div>
            <<numberslider "$CE_moneyOutMultiplier" $CE_moneyOutMultiplier 0.1 1 0.1>><br>
        </div>
        <br><br>

        <<if $debug>>

            <div class="dol-header">
                <span class="dol-title">Money Watch（金錢變動監控）</span>
            </div>
            <div class="dol-body">

                <div class="dol-desc">
                    每個遊戲秒結算未經原生交易入口的餘額淨變化，透過原生 money 記帳；開啟倍率時沿用收支倍率。
                </div>
                <div class="dol-desc dol-red">
                    只辨識採樣間的淨額，無法區分發薪與手動修正。修正餘額前請先關閉；讀檔及重新開啟會重建基線，不追補停用期間變化。原生交易不重複結算。
                </div>
                <<if window.CE_moneyWatch && window.CE_moneyWatch.error>>
                    <div class="dol-desc dol-red">收支路由已暫停：請查看控制台並核對餘額及 moneyStats。可能已有部分效果，系統不自動重試或回滾；處理後關閉再開啟監控。</div>
                <</if>>
                <br>

                <<if $CE_moneyWatchEnabled is undefined>>
                    <<set $CE_moneyWatchEnabled to false>>
                <</if>>

                <div class="dol-btn"><<button "Money Watch">>
                    <<set $CE_moneyWatchEnabled = $CE_moneyWatchEnabled ? false : true>>
                    <<run window.CE_moneyWatch && window.CE_moneyWatch.reset()>>
                    <<replace #CE_settingsDiv>><<CE_moneyCheat>><br><br><</replace>>
                <</button>></div>
                <br>

                <div class="dol-desc">
                    Money Watch：
                    <<if $CE_moneyWatchEnabled is false>>
                        <span class="dol-red">關</span>
                    <<else>>
                        <span class="dol-green">開</span>
                    <</if>>
                </div>

            </div>

        <</if>>

    </div>
</div>
<</widget>>
